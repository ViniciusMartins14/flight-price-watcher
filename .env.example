# Porta do dashboard web (só local — o Vercel define a própria)
PORT=3000

# Intervalo entre checagens de preço, em minutos (só usado pelo worker local)
CHECK_INTERVAL_MINUTES=20

# Número de WhatsApp padrão que recebe os alertas quando a rota não tem
# um número próprio definido no cadastro. Formato internacional só com
# dígitos: código do país + DDD + número. Ex: Brasil, São Paulo => 5511999999999
# (só usado pelo worker local, que é quem envia as mensagens)
WHATSAPP_TARGET_NUMBER=5511999999999

# Connection string do MongoDB Atlas — necessária tanto local quanto no
# Vercel (defina como env var do projeto no dashboard da Vercel).
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=flight_price_watcher

# true = navegador invisível durante o scraping, false = mostra o Chromium
# (só local/worker — no Vercel o scraper usa @sparticuz/chromium sempre headless)
SCRAPER_HEADLESS=true

# Chave secreta para assinar o token de sessão (login). Necessária tanto
# local quanto no Vercel (defina como env var do projeto no dashboard da
# Vercel — use um valor diferente do local). Gere a sua com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-e-secreto
