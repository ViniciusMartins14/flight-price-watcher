# Porta do dashboard web
PORT=3000

# Intervalo entre checagens de preço, em minutos
CHECK_INTERVAL_MINUTES=20

# Número de WhatsApp padrão que recebe os alertas quando a rota não tem
# um número próprio definido no cadastro. Formato internacional só com
# dígitos: código do país + DDD + número. Ex: Brasil, São Paulo => 5511999999999
WHATSAPP_TARGET_NUMBER=5511999999999

# Connection string do MongoDB Atlas (mesmo valor usado no Vercel em produção)
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=flight_price_watcher

# true = navegador invisível durante o scraping, false = mostra o Chromium (útil para depurar)
SCRAPER_HEADLESS=true
