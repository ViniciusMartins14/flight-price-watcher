# Porta do dashboard web
PORT=3000

# Intervalo entre checagens de preço, em minutos
CHECK_INTERVAL_MINUTES=20

# Número de WhatsApp que vai RECEBER os alertas (o seu próprio número),
# formato internacional só com dígitos: código do país + DDD + número
# Ex: Brasil, São Paulo, 99999-9999 => 5511999999999
WHATSAPP_TARGET_NUMBER=5511999999999

# Caminho do arquivo de banco de dados local (JSON)
DB_PATH=data/db.json

# true = navegador invisível durante o scraping, false = mostra o Chromium (útil para depurar)
SCRAPER_HEADLESS=true
